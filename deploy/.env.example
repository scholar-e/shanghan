# Environment variables for Shanghan-TCM Evidence
# Copy this file to .env and fill in the values

# Flask secret key (required for production)
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# DeepSeek API key (optional, enables AI chat functionality)
# Get from: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Server configuration
PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=false

# Optional: SSL/TLS (for HTTPS without a reverse proxy)
# Generate self-signed certs: openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Logging level
LOG_LEVEL=INFO

# Security settings
SESSION_COOKIE_SECURE=true  # Set to false for dev without HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Application settings
APP_NAME=Shanghan-TCM Evidence
APP_VERSION=v1.0.0
